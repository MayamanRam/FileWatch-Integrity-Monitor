# FileWatch Integrity Monitor - Environment Configuration
PROJECT_NAME="FileWatch"
VERSION="1.0.0"

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL="sqlite:///data/filewatch.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/filewatch"

# Security & Tamper Detection (Leave empty to auto-generate sealed key)
HMAC_SECRET_KEY=""

# Cryptographic Engine Parameters
HASH_CHUNK_SIZE_BYTES=65536
MAX_FILE_SIZE_BYTES=104857600

# Event Engine Parameters
EVENT_DEBOUNCE_SECONDS=1.0
PERIODIC_SCAN_INTERVAL_SECONDS=300

# CORS Allowed Origins
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

